# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=subscription_app_db
DATABASE_URL=postgresql://postgres:postgres_password_here@localhost:5432/subscription_app_db

# Security & JWT Authentication
SECRET_KEY=generate_a_secure_random_256bit_hex_key_here

# Redis Broker & Cache
REDIS_URL=redis://localhost:6379/0